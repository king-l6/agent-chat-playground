# Bilibili LLM 网关 / OpenAI 兼容接口
# 不填 Key 则自动进入 mock 模式，仍可演示流式 + tool 卡片
# 运行后也可在页面「配置」里填 Key，不必改这个文件

# 方式 A：Claude Code 同款 ANTHROPIC_*（推荐，公司网关）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=http://llmapi.bilibili.co
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-flash
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-flash
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash

# 方式 B：OpenAI 兼容（可覆盖上面）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://llmapi.bilibili.co/v1
# OPENAI_MODEL=deepseek-v4-flash

PORT=8790
VITE_API_BASE=http://127.0.0.1:8790

# 可选：HTTP MCP。更推荐在「配置」页点「从 Claude 导入」或手填 URL + Cookie
# MCP_URL=https://ai-fe.bilibili.co/mcp
# MCP_COOKIE=_AJSESSIONID=...
# MCP_AUTHORIZATION=Bearer ...

# 文档页 wiki 目录。不填则读 server/data/wiki（已从企微导出拷过来）
# PLAYGROUND_WIKI=/Users/bilibili/Desktop/脚本项目/wiki-dump/export_cv

# 入库时读图片里的字（不换向量模型）。同一网关、同一把 Key，模型要能看图
# VISION_MODEL=deepseek-v4-flash-vision

# 图片多模态向量：本地 CLIP（和 BGE 文字索引分开，检索时 RRF 融合）
# 网关 qwen3-vl-embedding 若无集群，会自动用 Xenova/clip-vit-base-patch32

# 静帧转动作：阿里云百炼万相参考生视频 wan2.7-r2v（免费额度在这个模型上）。不填则只用 ffmpeg 推拉静帧
# DASHSCOPE_API_KEY=
# 成片旁白：本机 IndexTTS-2.5（MLX，Apple Silicon）。不填参考音色则用 server/data/index-tts/ref.wav
# INDEX_TTS_REF=

# 检索向量：本项目用本地 BGE-small-zh（server/src/embed.ts）
# DeepSeek / 公司网关通常没有 /embeddings，不要把 chat 模型和 embedding 当成同一个接口
# 模型从 Hugging Face 镜像下载；墙外可改成 https://huggingface.co/
# HF_ENDPOINT=https://hf-mirror.com/
