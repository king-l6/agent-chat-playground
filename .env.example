# Bilibili LLM 网关 / OpenAI 兼容接口
# 不填 Key 则自动进入 mock 模式，仍可演示流式 + tool 卡片
# 运行后也可在页面「配置」里填 Key，不必改这个文件

# 方式 A：Claude Code 同款 ANTHROPIC_*（推荐，公司网关）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=http://llmapi.bilibili.co
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-flash
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-flash
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash

# 方式 B：OpenAI 兼容（可覆盖上面）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://llmapi.bilibili.co/v1
# OPENAI_MODEL=deepseek-v4-flash

# 上下文窗口（token）＝对话页用量环的分母。
# 优先级：配置页（llm.json）> 这里 > 代码兜底 32000。
# 那个 32000 不对应任何具体模型，只是保守缺省值；模型名在这个项目里是自由文本，
# 没有「模型名 → 官方窗口」的查表，所以要准的就得自己填。
#
# 业内常见档位（token）。**只是量级参考，不绑定任何模型**，回答的是
# 「该填多大才不离谱」，具体型号的窗口以网关 / 官方文档为准：
#   8k / 16k     早期档（GPT-3.5、GPT-4 初版那一代）
#   32k / 64k    上一代主流 —— 留空就是这一档
#   128k         现在 API 最常见（GPT-4o / DeepSeek V3 一类）
#   200k         Claude 系列常见，也是本文件示例值
#   1M / 2M      长上下文档（Gemini 1.5/2.x、GPT-4.1 一类）；2M 也是本项目允许的上界
#
# 填的时候注意两件事：
#   1) 别照抄别的模型 —— 数值只对你这把 Key 背后的网关有意义；
#   2) 本项目每轮还固定带 system prompt（规则 1–10 全文 + skill 目录 + 工作区块 +
#      MCP 块 + 记忆块）和 10 个工具 schema，这些前端算不进用量环，
#      所以窗口填小了环会长期贴着满格，那是「没填」的症状，不是模型只有这么大。
# 实在不确定就留空（=32k），至少是保守的。
# 合法区间 1000–2000000，超出视为乱填（读环境变量时忽略，配置页保存时会直接报错）。
# CONTEXT_WINDOW_TOKENS=200000
# 兼容旧名，CONTEXT_WINDOW_TOKENS 优先：
# OPENAI_CONTEXT_WINDOW=

PORT=8790
VITE_API_BASE=http://127.0.0.1:8790

# 可选：HTTP MCP。更推荐在「配置」页点「从 Claude 导入」或手填 URL + 请求头
# MCP_URL=https://ai-fe.bilibili.co/mcp
# MCP_COOKIE=_AJSESSIONID=...
# MCP_AUTHORIZATION=Bearer ...
# 自定义头（JSON 或多行 Header: value）：# MCP_HEADERS={"Cookie":"_AJSESSIONID=...","x-token":"..."}

# 文档页 wiki 目录。不填则读 server/data/wiki（已从企微导出拷过来）
# PLAYGROUND_WIKI=/Users/bilibili/Desktop/脚本项目/wiki-dump/export_cv

# 入库时读图片里的字（不换向量模型）。同一网关、同一把 Key，模型要能看图
# VISION_MODEL=deepseek-v4-flash-vision

# 图片多模态向量：本地 CLIP（和 BGE 文字索引分开，检索时 RRF 融合）
# 网关 qwen3-vl-embedding 若无集群，会自动用 Xenova/clip-vit-base-patch32

# 静帧转动作：阿里云百炼万相参考生视频 wan2.7-r2v（免费额度在这个模型上）。不填则只用 ffmpeg 推拉静帧
# DASHSCOPE_API_KEY=
# 成片旁白：本机 IndexTTS-2.5（MLX，Apple Silicon）。不填参考音色则用 server/data/index-tts/ref.wav
# INDEX_TTS_REF=

# 代码团队四段（LangGraph + LangChain）的 trace。不填 Key 则图照常跑，只是 LangSmith 上看不到。
# Key 从 https://smith.langchain.com 拿。项目名可改，不填时代码里用 agent-chat-playground。
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=agent-chat-playground

# 检索向量：本项目用本地 BGE-small-zh（server/src/embed.ts）
# DeepSeek / 公司网关通常没有 /embeddings，不要把 chat 模型和 embedding 当成同一个接口
# 模型从 Hugging Face 镜像下载；墙外可改成 https://huggingface.co/
# HF_ENDPOINT=https://hf-mirror.com/


# ============================================================================
# 内网服务形态（docker compose / 团队几个人用）
# ----------------------------------------------------------------------------
# 下面这些**只有在部署成服务时才需要**。本机开发、Electron 桌面壳全都留空即可，
# 留空时的行为跟加这一整套之前一模一样。
# 详细步骤见 README 的「服务器部署」章节。
# ============================================================================

# ---- 必填：访问令牌 -------------------------------------------------------
# 没配令牌 = 谁打开浏览器谁就能读走别人的 LLM Key / MCP Cookie（身份原本是前端自拟的
# X-Playground-User 请求头，改了就能冒充）。服务形态必须配。
#
# 一人一把（推荐，日志里能看到谁在干活）：
#   PLAYGROUND_ACCESS_TOKENS=alice:<t1>,bob:<t2>
#   生成：openssl rand -hex 24
# 或者单把共享（归属人统一记作 shared）：
#   PLAYGROUND_ACCESS_TOKEN=<t>
# 名字只用小写字母/数字/_/-：它要拼进 users/<名字>/ 目录路径，别的字符就是路径穿越。
#
# 换掉这里的值 = 立刻作废所有已发出的 cookie，不需要清会话表、不需要重启用户侧。
# PLAYGROUND_ACCESS_TOKENS=

# ---- 必填（compose 形态）：仓库目录 --------------------------------------
# 宿主上放代码仓库的目录。它会被**原样同路径**挂进 app 容器，
# 再交给沙箱容器（两边路径必须一致，否则沙箱会静默挂上一个空目录、命令跑在空气上）。
#   PLAYGROUND_REPOS_ROOT=/srv/repos
#
# 允许当工作区的根白名单（冒号分隔绝对路径），默认等于 REPOS_ROOT。
# 为什么必须有：工作区根会被 bind mount 进沙箱容器、也会被 workspace_read 直接读，
# 不限制的话持令牌者把它指到 /etc 或 ~/.ssh 就能绕过整个令牌门禁把宿主机读出来。
# 想再收紧就单独给，比如只放行两个仓库：
#   PLAYGROUND_WORKSPACE_ALLOWLIST=/srv/repos/red,/srv/repos/blue
# PLAYGROUND_WORKSPACE_ALLOWLIST=

# ---- 必填（compose 形态）：沙箱以谁的身份干活 ----------------------------
# 必须是**宿主上仓库属主**的 uid:gid，否则容器往挂载进来的仓库写文件会 EACCES。
# 查法：stat -c '%u:%g' /srv/repos
# 不给的话兜底是 0:0（容器主进程是 root）—— 表现是仓库里凭空多出一堆 root 属主的文件，
# 比报权限错更难查，所以尽量给上。
# PLAYGROUND_SANDBOX_UID=1000
# PLAYGROUND_SANDBOX_GID=1000

# ---- 交付泳道的隔离强度 ---------------------------------------------------
# off（默认）= 命令直接在宿主机上跑。本机开发用这个。
# docker     = 每条测试命令起一个一次性容器，断网、降权、限内存。服务形态用这个。
# 注意 docker 模式下 Docker 不可用会**直接报错，不会回落到宿主机** —— 这是故意的。
# PLAYGROUND_SANDBOX=off
# PLAYGROUND_SANDBOX_IMAGE=playground-sandbox:latest
# 资源上限。16G 机器上并发跑几条 run 很容易 OOM，所以三个都要有：
# PLAYGROUND_SANDBOX_MEMORY=2g
# PLAYGROUND_SANDBOX_CPUS=2
# PLAYGROUND_SANDBOX_PIDS=512
# 只读根 + 可写 /tmp。更硬，但要靠 tmpfs 和显式 cache 路径兜住 node/npm 的写需求；
# 默认关，先在目标仓库上验一遍再开。
# PLAYGROUND_SANDBOX_READONLY=1
#
# 准备依赖（npm ci）那一段要联网，用的私有源写这里：
# NPM_REGISTRY=https://registry.npmmirror.com

# ---- 监听与反代 -----------------------------------------------------------
# 默认 127.0.0.1（本机自用）。要让别的机器访问必须显式改，且必须先配令牌：
# 「非回环 + 没令牌」会被启动保险直接拒绝启动，宁愿起不来也不愿裸奔在内网。
# PLAYGROUND_LISTEN_HOST=0.0.0.0
# PLAYGROUND_PORT=8790
# 前面挂了 nginx（deploy/nginx.conf）才开：开了才认 X-Forwarded-For 取真实 IP
# （登录限流按 IP 计数）。直连时绝不能开，否则限流变成「每伪造一个头算一个新 IP」。
# PLAYGROUND_TRUST_PROXY=1
# 套了 https 才开。内网 http 下开这个，浏览器会把 cookie 直接丢掉、表现为登录成功但立刻又回登录页。
# PLAYGROUND_COOKIE_SECURE=1
# 跨源白名单（逗号分隔）。同源部署不需要配；配了就会顶掉默认的那条 file:// 放行。
# PLAYGROUND_CORS_ORIGIN=https://playground.internal.example

# ---- 发布前门禁 -----------------------------------------------------------
# 打分低于阈值就让 eval 以非零码退出。不设 = 不做门禁。
# 实测对着完整语料（10413 chunks / 555 篇 wiki）rerank 是 Recall@3 = 100%，0.8 不会误报。
# 注意只能在**喂过 wiki 的那台机器**上跑；CI 里跑不了，原因见 .github/workflows/ci.yml 末尾。
# PLAYGROUND_EVAL_MIN_RECALL=0.8
